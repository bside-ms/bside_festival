{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "project": ["**/*.{css,js,ts,tsx}", "!**/*.{test,spec}.{js,ts,tsx}", "!**/__tests__/**"],
    "ignore": ["**/*.{test,spec}.{js,ts,tsx}", "**/__tests__/**"],
    "ignoreDependencies": ["sharp", "@emnapi/core", "@emnapi/runtime", "imapflow"],
}
