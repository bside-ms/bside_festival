        "@fortawesome/react-fontawesome": "^3.3.0",
        "@hookform/resolvers": "^5.2.2",
        "@prisma/adapter-mariadb": "^7.9.0",
        "@prisma/client": "^7.9.0",
        "bytes": "^3.1.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^17.4.2",
        "framer-motion": "^13.0.0",
        "imapflow": "^1.6.5",
        "libphonenumber-js": "^1.12.41",
        "lodash": "^4.17.23",
        "mime-types": "^3.0.2",
        "next": "^16.2.11",
        "next-auth": "^4.24.13",
        "nodemailer": "^9.0.1",
        "nuqs": "^2.9.4",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.72.0",
        "react-icons": "^5.6.0",
        "react-select": "^5.10.2",
        "sharp": "^0.35.3",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@emnapi/core": "^1.11.1",
