        "@types/lodash": "^4.17.24",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^25.5.0",
        "@types/nodemailer": "^7.0.11",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "knip": "^6.12.2",
        "postcss": "^8.5.23",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "prisma": "^7.9.0",
        "sass": "^1.98.0",
        "tailwindcss": "^4.2.2",
        "tsx": "^4.22.4",
