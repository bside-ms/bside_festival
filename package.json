{
    "name": "bside_festival",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "check": "npm run tsc && npm run lint && npm run test && npm run find-unused && npm run audit && npm run prettier",
        "audit": "npm audit --audit-level=high",
        "lint": "eslint -c eslint.config.mjs .",
        "lint:fix": "eslint --fix -c eslint.config.mjs .",
        "test": "vitest run",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch",
        "find-unused": "knip --no-config-hints",
        "prisma:migrations:dev": "npx prisma migrate dev",
        "prisma:migrations:deploy": "npx prisma migrate deploy",
        "prisma:client:generate": "prisma generate",
        "prettier": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "send-confirmation-mails": "tsx scripts/sendConfirmationMails.ts",
        "send-acceptance-mails": "tsx scripts/sendAcceptanceMails.ts",
        "send-exhibition-acceptance-mails": "tsx scripts/sendExhibitionAcceptanceMails.ts",
        "send-festival-mail": "tsx scripts/sendFestivalMail.ts",
        "imap-mail": "tsx scripts/imapMail.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1014.0",
        "@floating-ui/react": "^0.27.19",
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
