generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Participant {
  id                     Int                @id @default(autoincrement())
  name                   String             @db.Text
  appliedAt              DateTime?
  updatedAt              DateTime           @updatedAt
  contactName            String?            @db.Text
  contactMail            String?            @db.Text
  contactPhone           String?            @db.Text
  description            String?            @db.Text
  motivation             String?            @db.Text
  curationScore          Int?
  curationInfo           String?            @db.Text
  address                String?            @db.Text
  residence              String?            @db.Text
  imageFileName          String?            @db.Text
  technicalRider         String?            @db.Text
  technicalRiderFileName String?            @db.Text
  additionalInfo         String?            @db.Text
  links                  Link[]
  comments               Comment[]
  labels                 ParticipantLabel[]
  type                   Type
  status                 ApplicationStatus  @default(Applied)
}

model Link {
  id            Int         @id @default(autoincrement())
  participant   Participant @relation(fields: [participantId], references: [id])
  participantId Int
  link          String      @db.Text
}

model Comment {
  id            Int         @id @default(autoincrement())
  participant   Participant @relation(fields: [participantId], references: [id])
  participantId Int
  comment       String      @db.Text
  commentator   String      @db.Text
  updatedAt     DateTime    @updatedAt
}

model Label {
  id           Int                @id @default(autoincrement())
  label        String             @db.Text
  particapants ParticipantLabel[]
}

model ParticipantLabel {
  participant   Participant @relation(fields: [participantId], references: [id])
  participantId Int
  label         Label       @relation(fields: [labelId], references: [id])
  labelId       Int

  @@id([participantId, labelId])
}

enum Type {
  Concert
  Workshop
  Reading
  Performance
  FamilyProgram
  Exhibition
  Food
  Neighbor
  Misc
  DiskJockey
}

enum ApplicationStatus {
  Applied
  Rejected
  InProgress
  WaitingForConfirmation
  Confirmed
}

model Location {
  id   Int    @id @default(autoincrement())
  name String @db.Text
}

model Volunteer {
  int                   Int     @id @default(autoincrement())
  fullName              String  @db.Text
  mailAddress           String  @db.Text
  phoneNumber           String  @db.Text
  canCook               Boolean @default(false)
  hasCar                Boolean @default(false)
  canCarryHeavyStuff    Boolean @default(false)
  isSocial              Boolean @default(false)
  canSupportTechnician  Boolean @default(false)
  canSupportArtist      Boolean @default(false)
  hasMultipleTalents    Boolean @default(false)
  canWorkWithChildren   Boolean @default(false)
  isAvailableOnFriday   Boolean @default(false)
  isAvailableOnSaturday Boolean @default(false)
  isAvailableOnSunday   Boolean @default(false)
}
