generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "mysql"
}

model Participant {
    id                          Int                @id @default(autoincrement())
    name                        String             @db.Text
    updatedName                 String?            @db.Text
    appliedAt                   DateTime?
    updatedAt                   DateTime           @updatedAt
    contactName                 String?            @db.Text
    contactMail                 String             @db.Text
    contactPhone                String?            @db.Text
    description                 String?            @db.Text
    updatedDescription          String?            @db.Text
    motivation                  String?            @db.Text
    juryVotes                   Json?
    address                     String?            @db.Text
    imageFileName               String?            @db.Text
    technicalRider              String?            @db.Text
    technicalRiderFileName      String?            @db.Text
    backlineSharing             String?            @db.Text
    additionalInfo              String?            @db.Text
    participantCount            Int                @default(1)
    allergies                   String?            @db.Text
    hasParticipatedBefore       Boolean?
    isProfessionalBooking       Boolean            @default(false)
    flintaParticipantsCount     Int                @default(0)
    professionalParticipantsCount Int              @default(0)
    hasMarginalizedParticipants Boolean            @default(false)
    durationPreference          String?            @db.Text
    diversityNotes              String?            @db.Text
    emailVerified               DateTime?
    verificationTokens          EmailVerificationToken[]
    zipcodes                    Zipcode[]
    links                       Link[]
    comments                    Comment[]
    organizers                  ParticipantOrganizer[]
    labels                      ParticipantLabel[]
    genres                      ParticipantGenre[]
    type                        Type
    status                      ApplicationStatus  @default(Applied)
    Slot                        Slot[]
    Venue                       Venue[]
}

model ChangeLogEntry {
    id           Int                 @id @default(autoincrement())
    createdAt    DateTime            @default(now())
    actorName    String?             @db.Text
    actorEmail   String?             @db.Text
    targetType   ChangeLogTargetType
    targetId     Int
    targetName   String              @db.Text
    action       ChangeLogAction
    message      String              @db.Text
    changes      Json

    @@index([createdAt])
    @@index([targetType, targetId])
    @@index([action])
}

enum ChangeLogTargetType {
    Application
    ProgramEntry
}

enum ChangeLogAction {
    ApplicationNameUpdated
    ApplicationDescriptionUpdated
    ApplicationMotivationUpdated
    ApplicationParticipantCountUpdated
    ApplicationDurationPreferenceUpdated
    ApplicationPastParticipationUpdated
    ApplicationJuryVotesUpdated
    ApplicationBookingInfoUpdated
    ApplicationDiversityInfoUpdated
    ApplicationAdditionalInfoUpdated
    ApplicationContactInfoUpdated
    ApplicationImageDeleted
    ApplicationImageReplaced
    ApplicationStatusUpdated
    ApplicationOrganizersUpdated
    ProgramSlotUpdated
    ProgramSlotDeleted
    ProgramVenueUpdated
    ProgramVenueDeleted
}

model EmailVerificationToken {
    id              Int         @id @default(autoincrement())
    participant     Participant @relation(fields: [participantId], references: [id])
    participantId   Int
    token           String      @unique
    expires         DateTime
}

model Zipcode {
    id              Int         @id @default(autoincrement())
    participant     Participant @relation(fields: [participantId], references: [id])
    participantId   Int
    code            String      @db.Text
    isInternational Boolean     @default(false)
}

model Link {
    id             Int         @id @default(autoincrement())
    participant    Participant @relation(fields: [participantId], references: [id])
    participantId  Int
    link           String      @db.Text
    isConfidential Boolean     @default(false)
}

model Comment {
    id               Int                @id @default(autoincrement())
    participant      Participant        @relation(fields: [participantId], references: [id])
    participantId    Int
    text             String             @db.Text
    authorUserId     String             @db.Text
    authorName       String             @db.Text
    createdAt        DateTime           @default(now())
    statusTransition ApplicationStatus?
}

model ParticipantOrganizer {
    participant     Participant @relation(fields: [participantId], references: [id])
    participantId   Int
    organizerUserId String      @db.VarChar(191)
    organizerName   String      @db.Text

    @@id([participantId, organizerUserId])
}

model Label {
    id           Int                @id @default(autoincrement())
    label        String             @db.Text
    particapants ParticipantLabel[]
}

model ParticipantLabel {
    participant   Participant @relation(fields: [participantId], references: [id])
    participantId Int
    label         Label       @relation(fields: [labelId], references: [id])
    labelId       Int

    @@id([participantId, labelId])
}

model Genre {
    id           Int                @id @default(autoincrement())
    name         String             @db.Text
    type         Type
    participants ParticipantGenre[]
}

model ParticipantGenre {
    participant   Participant @relation(fields: [participantId], references: [id])
    participantId Int
    genre         Genre       @relation(fields: [genreId], references: [id])
    genreId       Int

    @@id([participantId, genreId])
}

enum Type {
    Concert
    Workshop
    Reading
    Performance
    FamilyProgram
    Exhibition
    Food
    Neighbor
    Misc
    DiskJockey
    InfoBooth
    Catering
}

enum ApplicationStatus {
    Applied
    InConsideration
    Contacted
    WaitingForConfirmation
    Confirmed
    Rejected
    Canceled
}

model Location {
    id            Int     @id @default(autoincrement())
    name          String  @db.Text
    address       String? @db.Text
    latitude      Float?  @db.Float
    longitude     Float?  @db.Float
    awarenessInfo String? @db.Text
    Slot          Slot[]
    Venue         Venue[]
}

// Slot is for program that starts at a specific time at the location
model Slot {
    id            Int         @id @default(autoincrement())
    begin         DateTime
    duration      Int
    participantId Int
    participant   Participant @relation(fields: [participantId], references: [id])
    locationId    Int
    location      Location    @relation(fields: [locationId], references: [id])
    maxAttendees  Int?
    Attendee      Attendee[]
}

// Venue is for program that is at the location during the entire festival
model Venue {
    id            Int         @id @default(autoincrement())
    participantId Int
    participant   Participant @relation(fields: [participantId], references: [id])
    locationId    Int
    location      Location    @relation(fields: [locationId], references: [id])
    dates         String?     @db.Text
}

model Volunteer {
    // Primary key is called int instead of id by accident >_<
    int                   Int     @id @default(autoincrement())
    fullName              String  @db.Text
    mailAddress           String  @db.Text
    phoneNumber           String  @db.Text
    canCook               Boolean @default(false)
    hasCar                Boolean @default(false)
    canCarryHeavyStuff    Boolean @default(false)
    isSocial              Boolean @default(false)
    canSupportTechnician  Boolean @default(false)
    canSupportArtist      Boolean @default(false)
    hasMultipleTalents    Boolean @default(false)
    canWorkWithChildren   Boolean @default(false)
    isAvailableOnFriday   Boolean @default(false)
    isAvailableOnSaturday Boolean @default(false)
    isAvailableOnSunday   Boolean @default(false)
    isAvailableBefore     Boolean @default(false)
    additionalInfo        String? @db.Text
}

model Attendee {
    id          Int      @id @default(autoincrement())
    fullName    String   @db.Text
    mailAddress String   @db.Text
    attendedAt  DateTime
    slotId      Int
    slot        Slot     @relation(fields: [slotId], references: [id])
}
